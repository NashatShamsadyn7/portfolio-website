{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "docs/**",
      "**/*.md",
      "**/*.log",
      "**/*.ps1",
      "**/*.test.js",
      "**/test/**",
      "**/tests/**",
      "**/.*",
      "**/node_modules/**",
      "projects/**",
      "speech2text/**",
      "downloads/**",
      "**/*.msi"
    ],
    "headers": [
      {
        "source": "/app-updates.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/imposter-version.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          },
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), camera=(), microphone=()"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/longcat-chatbot",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/longcat-chatbot.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/downloads/islamic-nashat.zip",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/Islamic-Nashat.apk",
        "type": 302
      },
      {
        "source": "/downloads/islamic-nashat.apk",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/Islamic-Nashat.apk",
        "type": 302
      },
      {
        "source": "/downloads/tv-app.zip",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.09.10/app-release.apk",
        "type": 302
      },
      {
        "source": "/downloads/nashat-tv.apk",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.09.10/app-release.apk",
        "type": 302
      },
      {
        "source": "/downloads/domina-project.zip",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.31/Domina-Score-Counter.apk",
        "type": 302
      },
      {
        "source": "/downloads/domina-score-counter.apk",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.31/Domina-Score-Counter.apk",
        "type": 302
      },
      {
        "source": "/downloads/speechflow-windows.zip",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/SpeechFlow-Setup.exe",
        "type": 302
      },
      {
        "source": "/downloads/speechflow-setup.exe",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/SpeechFlow-Setup.exe",
        "type": 302
      },
      {
        "source": "/downloads/nashat-tv-desktop-setup.exe",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/Nashat-TV-Desktop-Setup.exe",
        "type": 302
      },
      {
        "source": "/downloads/islamic-nashat-widget.exe",
        "destination": "https://github.com/NashatShamsadyn7/app-downloads/releases/download/v2026.08.04/IslamicNashatWidget.exe",
        "type": 302
      }
    ]
  }
}
